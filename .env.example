# local database started by docker compose
DATABASE_URL="postgresql://polar:polar@localhost:5432/polar"
# 'portal da transparencia', the request header must have:
# "[{"key":"chave-api-dados","value":"your-api-key"}]"
GOV_API_KEY=
# site revalidation after ingestion: the web app checks the secret, the workflows send it
# (GitHub secret REVALIDATE_SECRET and variable REVALIDATE_URL, for example https://<site>/api/revalidate)
REVALIDATE_SECRET=""